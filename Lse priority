"""
Matches LSE Main Market, UK-incorporated issuers (from a manually
downloaded LSE Issuer List spreadsheet) to Companies House company
numbers, producing a priority list of major listed companies to
monitor continuously, regardless of whether the bulk pre-filter
(bulk_scan.py) has already flagged them.

Why this is a SEPARATE list from the bulk pre-filter's candidates,
not just a priority boost within them: bulk_scan.py's candidates are
companies already showing a distress signal (overdue filings, distress
status). Large listed companies rarely trip that filter until
something has already gone seriously wrong, by which point it's late
for "early warning" purposes. So LSE-listed companies are treated like
a second watchlist.csv, always fully checked every run in main.py,
not folded into the smaller rotating bulk backlog.

This is NOT the FTSE All-Share index itself, no automated,
terms-verified way to pull that was available (see conversation
history). It's a proxy: Main Market listing plus UK incorporation,
since only UK-incorporated companies have Companies House numbers at
all. ~649 companies from the July 2026 issuer list, versus FTSE
All-Share's ~600-640 constituents historically, a reasonable but not
exact stand-in. Investment trusts and companies incorporated
offshore for tax/structural reasons (common for REITs) are excluded
here even if they'd be FTSE All-Share constituents, since they have no
Companies House number to check in the first place.

Source data: manually downloaded from
https://www.londonstockexchange.com/reports?tab=issuers (the page is
a JavaScript app, no stable automatable URL was found, this has to
stay a manual, periodic download, place the file at the --input path
before running this script). Refresh cadence is up to you, this list
doesn't change daily.

Matching approach: Companies House's registered name usually differs
from the LSE issuer name only in case and the PLC/LIMITED suffix
(e.g. "3I GROUP PLC" here vs "3i Group plc" on the register). This
script normalizes both sides (uppercase, strip punctuation and common
suffixes) and accepts a match only if it's exact after normalization,
or the top search result if not, but flags the latter as
needs_review so a human confirms it rather than silently trusting a
fuzzy match. Check the needs_review rows in the output CSV before
relying on this list.
"""

import argparse
import csv
import os
import re
import sys
import time

import openpyxl

from ch_client import CompaniesHouseClient

SUFFIX_PATTERN = re.compile(r"\b(PLC|LIMITED|LTD)\b", re.IGNORECASE)
PUNCTUATION_PATTERN = re.compile(r"[^A-Z0-9 ]")


def normalize_name(name):
    name = (name or "").upper()
    name = SUFFIX_PATTERN.sub("", name)
    name = PUNCTUATION_PATTERN.sub(" ", name)
    return " ".join(name.split())


def load_issuers(path):
    """Reads the LSE Issuer List xlsx, filters to Main Market, UK-incorporated."""
    wb = openpyxl.load_workbook(path, data_only=True)
    ws = wb["Companies"]

    # Find the header row (varies slightly release to release, search for it
    # rather than assuming a fixed row number).
    header_row_idx = None
    for i, row in enumerate(ws.iter_rows(min_row=1, max_row=15, values_only=True), start=1):
        if row and "Company Name" in row:
            header_row_idx = i
            break
    if header_row_idx is None:
        raise RuntimeError(
            "Could not find the header row (looking for a 'Company Name' "
            "column) in the first 15 rows. Check the file format hasn't changed."
        )

    headers = [str(c.value).strip() if c.value else "" for c in ws[header_row_idx]]
    name_col = headers.index("Company Name")
    country_col = headers.index("Country of Incorporation")
    market_col = headers.index("Market")

    issuers = []
    for row in ws.iter_rows(min_row=header_row_idx + 1, values_only=True):
        name = row[name_col]
        if not name:
            continue
        country = (row[country_col] or "").strip()
        market = (row[market_col] or "").strip()
        if market == "MAIN MARKET" and country == "United Kingdom":
            issuers.append(name.strip())

    return issuers


def match_issuer(client, issuer_name):
    """Returns (company_number, matched_name, needs_review) or (None, None, None)."""
    target = normalize_name(issuer_name)
    try:
        results = client.search_companies(issuer_name, items_per_page=5)
    except Exception as e:
        print(f"  Search failed for '{issuer_name}': {e}", file=sys.stderr)
        return None, None, None

    if not results or not results.get("items"):
        return None, None, None

    for item in results["items"]:
        candidate_name = item.get("title", "")
        if normalize_name(candidate_name) == target:
            return item.get("company_number"), candidate_name, False

    # No exact normalized match, fall back to the top result but flag for review.
    top = results["items"][0]
    return top.get("company_number"), top.get("title"), True


def run(input_path, output_path):
    issuers = load_issuers(input_path)
    print(f"{len(issuers)} Main Market, UK-incorporated issuers to match.")

    client = CompaniesHouseClient()

    rows = []
    exact_count = 0
    review_count = 0
    unmatched_count = 0

    for i, issuer_name in enumerate(issuers, start=1):
        company_number, matched_name, needs_review = match_issuer(client, issuer_name)
        if company_number is None:
            unmatched_count += 1
            rows.append([issuer_name, "", "", "unmatched"])
        elif needs_review:
            review_count += 1
            rows.append([issuer_name, company_number, matched_name, "needs_review"])
        else:
            exact_count += 1
            rows.append([issuer_name, company_number, matched_name, "exact"])

        if i % 100 == 0:
            print(f"  matched {i}/{len(issuers)}...")
        time.sleep(0.05)  # gentle pacing, well within the client's own rate limiter too

    os.makedirs(os.path.dirname(output_path) or ".", exist_ok=True)
    with open(output_path, "w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow(["lse_issuer_name", "company_number", "matched_company_name", "match_status"])
        writer.writerows(rows)

    print(
        f"\nDone. {exact_count} exact matches, {review_count} need manual review, "
        f"{unmatched_count} unmatched. Written to {output_path}."
    )
    if review_count or unmatched_count:
        print(
            "Check the needs_review and unmatched rows in the output file before "
            "trusting this list fully, see the module docstring for why."
        )


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Match LSE issuers to Companies House numbers")
    parser.add_argument("--input", default="data/lse_issuer_list.xlsx")
    parser.add_argument("--output", default="data/lse_priority_companies.csv")
    args = parser.parse_args()
    run(args.input, args.output)
